# Railway / PostgreSQL Connection URL
# On Railway, when you add a PostgreSQL database, Railway automatically injects DATABASE_URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio"

# Admin Credentials
ADMIN_EMAIL="your_admin_email@example.com"
ADMIN_PASSWORD="your_strong_admin_password_here"

# JWT secret for session signature (automatically generated if not provided)
JWT_SECRET="your_64_char_random_hex_jwt_secret_here"

# Telegram notifications
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"

# Frontend Vite Environment Variables (EmailJS & Admin Email)
VITE_EMAILJS_SERVICE_ID="your_emailjs_service_id_here"
VITE_EMAILJS_TEMPLATE_ID="your_emailjs_template_id_here"
VITE_EMAILJS_PUBLIC_KEY="your_emailjs_public_key_here"
VITE_ADMIN_EMAIL="your_admin_email@example.com"

# Optional Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"